# @q-labs/cobalt is published to GitHub Packages, not the public npm registry.
# Students need a GitHub Personal Access Token with `read:packages` scope.
# See installfest/installfest.md for the full walkthrough.
#
# Required environment variable:
#   export GITHUB_TOKEN=ghp_yourTokenHere
#
# pnpm will substitute ${GITHUB_TOKEN} at install time.

@q-labs:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# Avoid surprise behavior changes when pnpm bumps majors.
engine-strict=true
